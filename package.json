{
  "name": "apex-dev",
  "version": "3.10.10",
  "type": "module",
  "description": "Apex AI - a friendly agentic coding assistant for the terminal",
  "main": "dist/index.js",
  "bin": {
    "apex": "./cli.js"
  },
  "files": [
    "dist/",
    "lib/",
    "cli.js",
    "install.js",
    "index.js"
  ],
  "scripts": {
    "build": "bun build ./src/index.js --outfile dist/index.js && sed -i '1s/.*/#!/usr/bin/env node/' dist/index.js",
    "build:compile": "bun build --compile ./src/index.js --outfile dist/apex-dev",
    "postinstall": "node install.js",
    "prepack": "npm run build",
    "start": "node apex.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentui/core": "^0.1.83",
    "@opentui/react": "^0.1.83",
    "@sourcegraph/amp": "^0.0.1772503238-g61db4a",
    "codebuff": "^1.0.622",
    "openai": "^6.25.0",
    "opencode-ai": "1.2.14",
    "react": "^19.2.4",
    "react-reconciler": "^0.32.0",
    "vercel": "^50.25.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
