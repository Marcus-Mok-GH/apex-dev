{
  "name": "apex-dev",
  "version": "3.10.43",
  "description": "Apex AI - a friendly agentic coding assistant for the terminal",
  "main": "dist/index.js",
  "bin": {
    "apex": "./cli.js"
  },
  "files": [
    "dist/",
    "cli.js"
  ],
  "scripts": {
    "build": "bun scripts/build-entry.mjs && NODE_ENV=production bun build entry.mjs --target=bun --outfile=dist/index.js --packages=external",
    "prepack": "npm run build",
    "start": "bun apex.mjs",
    "test": "bunx repterm tests/",
    "test:record": "bunx repterm --record tests/",
    "test:verbose": "bunx repterm -v tests/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentui/core": "^0.1.83",
    "@opentui/react": "^0.1.83",
    "openai": "^6.25.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "repterm": "^0.2.1"
  }
}
